# -----------------------------------------------------------------------------
# Carrito IoT Frontend - environment variables
# Copy this file to `.env` and fill in the values you need.
# -----------------------------------------------------------------------------

# Base URL of the real backend REST API, INCLUDING the `/api` suffix.
# Example: https://your-backend.example.com/api
# Leave empty to run the app in simulated (in-browser) demo mode.
VITE_API_URL=

# WebSocket URL of the real backend (native WebSocket on port 5000 originally).
# Example: wss://your-backend.example.com
# Leave empty when there is no backend or no WebSocket server.
VITE_WS_URL=

# Optional. Target for the Vite dev-server proxy (`/api` -> target).
# Only needed to avoid CORS during local development.
# Example: http://localhost:5001
VITE_API_PROXY_TARGET=

# Optional. Device identifier expected by the backend.
# Defaults to ESP8266-CAR-001 when not set.
VITE_DEVICE_ID=

# Optional. Deploy base path.
# Defaults to '/Iot_carrito_aws_frontend/' (GitHub Pages).
# Set VITE_BASE=/ when hosting on Vercel/Netlify (root-served) or any other
# host that serves the app from '/'.
VITE_BASE=

# -----------------------------------------------------------------------------
# Example: frontend on Vercel + backend on EC2 behind Cloudflare Tunnel
#   VITE_API_URL=https://api.your-domain.com/api   # REST (build-time)
#   VITE_WS_URL=wss://ws.your-domain.com           # WebSocket (secure, wss)
#   VITE_BASE=/
# (VITE_API_URL and VITE_WS_URL are read at BUILD time, so set them in the
#  Vercel project's Environment Variables and redeploy.)
# -----------------------------------------------------------------------------
